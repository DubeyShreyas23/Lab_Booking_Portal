# ── Server ───────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
SESSION_SECRET=change-me-to-a-long-random-string
CSRF_SECRET=change-me-too-or-it-falls-back-to-session-secret
PORTAL_URL=http://localhost:3000

# ── Database (Supabase Postgres) ─────────────────────────────────────────
# Supabase → Project Settings → Database → Connection string → "Session pooler"
# (URI, port 5432). It looks like:
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=
# Set PGSSL=disable ONLY for a local Postgres without TLS. Leave unset for Supabase.
# PGSSL=

# ── Identity ─────────────────────────────────────────────────────────────
# Allowed institute email domains (comma-separated). All Google sign-ins
# must come from one of these. Anyone else is rejected.
ALLOWED_DOMAINS=hyderabad.bits-pilani.ac.in,pilani.bits-pilani.ac.in,goa.bits-pilani.ac.in

# Google OAuth 2.0 — get these from https://console.cloud.google.com/apis/credentials
# Authorized redirect URI in Google Cloud must be:
#   {PORTAL_URL}/auth/google/callback
# Leave blank to disable Google login (dev-mode magic-login is then enabled when NODE_ENV != production).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# First admin auto-created on first boot (if no admin exists)
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=Lab Administrator

# ── Email (system notifications: pending, approved, rejected) ────────────
MAIL_FROM_NAME=Central Analytical Laboratory
MAIL_FROM_ADDRESS=cal-online@hyderabad.bits-pilani.ac.in
LAB_CONTACT=Dr Ramakrishnan Ganesan

# SMTP — leave blank to print emails to console instead of sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
