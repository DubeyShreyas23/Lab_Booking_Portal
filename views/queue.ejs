<%- include('partials/head') %>
<h1 class="text-2xl font-semibold text-slate-900 mb-1"><%= stage === 'technician' ? 'Technician queue' : 'Faculty approvals' %></h1>
<p class="text-sm text-slate-500 mb-5">
  <% if (stage === 'technician') { %>
    Review pending requests for instruments under your care. Approve to forward to faculty, or reject with a reason.
  <% } else { %>
    Final approval as the student's supervisor. Approving will email the student that their booking is confirmed.
  <% } %>
</p>

<section class="bg-white border rounded-xl overflow-hidden">
  <header class="px-4 py-2 text-xs uppercase tracking-wide text-slate-500 bg-slate-50 border-b">Pending (<%= pending.length %>)</header>
  <% if (!pending.length) { %>
    <p class="px-4 py-6 text-sm text-slate-500 text-center">All caught up.</p>
  <% } else { %>
    <ul class="divide-y">
      <% pending.forEach(function(b){ %>
        <li class="px-4 py-3 sm:flex sm:items-center sm:gap-4">
          <div class="flex-1 min-w-0">
            <div class="font-medium text-slate-900">
              <a href="/bookings/<%= b.id %>" class="hover:underline"><%= b.instrument_name %></a>
              · <%= b.dateLong %> · <%= b.startTime %>–<%= b.endTime %>
            </div>
            <div class="text-sm text-slate-600 mt-0.5">
              Requested by <strong><%= b.student_name %></strong>
              <span class="text-slate-400">&lt;<%= b.student_email %>&gt;</span>
              <% if (stage === 'technician' && b.faculty_name) { %>
                · Supervisor: <%= b.faculty_name %>
              <% } %>
              · <%= b.durationLabel %>
              <% if (b.purpose) { %>· "<%= b.purpose %>"<% } %>
              · <a href="/bookings/<%= b.id %>" class="text-brand-600 hover:underline">details →</a>
            </div>
          </div>
          <div class="mt-2 sm:mt-0 flex items-center gap-2">
            <form method="post" action="/<%= stage %>/<%= b.id %>/approve" class="inline">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="bg-emerald-600 hover:bg-emerald-700 text-white text-sm px-3 py-1.5 rounded">Approve</button>
            </form>
            <details class="relative">
              <summary class="list-none bg-rose-50 hover:bg-rose-100 text-rose-700 text-sm px-3 py-1.5 rounded cursor-pointer">Reject…</summary>
              <form method="post" action="/<%= stage %>/<%= b.id %>/reject" class="absolute right-0 mt-2 bg-white border rounded shadow-lg p-3 w-72 z-10 space-y-2">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <textarea name="reason" rows="3" required placeholder="Reason for rejection" class="w-full px-2 py-1.5 border rounded text-sm"></textarea>
                <button class="w-full bg-rose-600 hover:bg-rose-700 text-white text-sm py-1.5 rounded">Confirm rejection</button>
              </form>
            </details>
          </div>
        </li>
      <% }) %>
    </ul>
  <% } %>
</section>

<section class="bg-white border rounded-xl overflow-hidden mt-6">
  <header class="px-4 py-2 text-xs uppercase tracking-wide text-slate-500 bg-slate-50 border-b">Recent history</header>
  <% if (!history.length) { %>
    <p class="px-4 py-6 text-sm text-slate-500 text-center">No history yet.</p>
  <% } else { %>
    <ul class="divide-y text-sm">
      <% history.forEach(function(b){ %>
        <li class="px-4 py-2 flex items-center gap-3">
          <% var color = ({
              pending_technician:'bg-amber-100 text-amber-800',
              pending_faculty:'bg-amber-100 text-amber-800',
              approved:'bg-emerald-100 text-emerald-800',
              rejected:'bg-rose-100 text-rose-800',
              cancelled:'bg-slate-100 text-slate-600',
              completed:'bg-sky-100 text-sky-800',
            })[b.status] %>
          <span class="<%= color %> px-2 py-0.5 rounded text-xs font-medium w-32 text-center"><%= b.status.replace('_',' ') %></span>
          <span class="flex-1"><%= b.instrument_name %> · <%= b.dateLong %> · <%= b.startTime %>–<%= b.endTime %></span>
          <span class="text-slate-500"><%= b.student_name %></span>
        </li>
      <% }) %>
    </ul>
  <% } %>
</section>
<%- include('partials/foot') %>
