<header class="bg-white/95 backdrop-blur border-b border-slate-200 shadow-sm sticky top-0 z-40">
  <div class="max-w-6xl mx-auto px-4 h-16 flex items-center justify-between gap-4">
    <a href="/" class="flex items-center shrink-0 transition hover:opacity-90">
      <img src="/img/best-lab-logo.png" alt="BITS Environmental Science & Technology (BEST) Lab" class="h-11 w-auto">
    </a>
    <% if (user) { %>
      <nav class="flex items-center gap-0.5 text-sm text-slate-600 font-medium">
        <% if (user.role === 'technician') { %>
          <a href="/technician" class="px-3 py-1.5 rounded hover:bg-slate-100">Queue</a>
          <a href="/reports" class="px-3 py-1.5 rounded hover:bg-slate-100">Reports</a>
        <% } %>
        <% if (user.role === 'faculty' || user.role === 'admin') { %>
          <a href="/admin" class="px-3 py-1.5 rounded hover:bg-slate-100">Dashboard</a>
          <a href="/admin/inventory" class="px-3 py-1.5 rounded hover:bg-slate-100">Inventory</a>
          <a href="/admin/instruments" class="px-3 py-1.5 rounded hover:bg-slate-100">Instruments</a>
          <a href="/admin/users" class="px-3 py-1.5 rounded hover:bg-slate-100">Users</a>
          <a href="/admin/holidays" class="px-3 py-1.5 rounded hover:bg-slate-100">Holidays</a>
          <a href="/faculty" class="px-3 py-1.5 rounded hover:bg-slate-100">Approvals</a>
          <a href="/reports" class="px-3 py-1.5 rounded hover:bg-slate-100">Reports</a>
          <a href="/admin/settings" class="px-3 py-1.5 rounded hover:bg-slate-100">Settings</a>
          <a href="/admin/broadcast" class="px-3 py-1.5 rounded hover:bg-slate-100">Announce</a>
        <% } %>
        <!-- Booking access is available to EVERY role — a PhD incharge is also -->
        <!-- a researcher who needs to book other equipment for their own work. -->
        <a href="<%= user.role === 'student' ? '/' : '/my-bookings' %>" class="px-3 py-1.5 rounded hover:bg-slate-100">My bookings</a>
        <a href="/instruments" class="px-3 py-1.5 rounded hover:bg-slate-100"><%= user.role === 'student' ? 'Instruments' : 'Book equipment' %></a>
        <a href="/complaints" class="px-3 py-1.5 rounded hover:bg-slate-100">Complaints</a>
        <a href="/contact" class="px-3 py-1.5 rounded hover:bg-slate-100">Contact</a>
        <a href="/kiosk" target="_blank" class="px-3 py-1.5 rounded hover:bg-slate-100 text-slate-500 text-xs">Kiosk ↗</a>
        <span class="ml-2 text-slate-500 hidden md:inline"><%= user.name %></span>
        <form method="post" action="/logout" class="inline">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="ml-2 px-3 py-1.5 rounded border hover:bg-slate-50">Sign out</button>
        </form>
      </nav>
    <% } else { %>
      <nav class="flex items-center gap-3 text-sm">
        <a href="/contact" class="text-slate-600 hover:text-brand-600 hover:underline">Contact</a>
        <a href="/login" class="text-brand-600 hover:underline">Sign in</a>
      </nav>
    <% } %>
  </div>
</header>
