<%- include('../partials/head') %>
<%
  const statusColor = {
    pending_technician:'bg-amber-100 text-amber-800',
    pending_faculty:'bg-amber-100 text-amber-800',
    approved:'bg-emerald-100 text-emerald-800',
    rejected:'bg-rose-100 text-rose-800',
    cancelled:'bg-slate-100 text-slate-600',
    completed:'bg-sky-100 text-sky-800',
    no_show:'bg-orange-100 text-orange-800',
  }[booking.status];
%>

<div class="grid lg:grid-cols-[1fr_360px] gap-6">
  <section class="bg-white border rounded-xl p-6">
    <div class="flex items-start justify-between">
      <div>
        <div class="text-xs text-slate-500 uppercase tracking-wide">Booking #<%= booking.id %></div>
        <h1 class="text-2xl font-semibold text-slate-900 mt-1"><%= booking.instrument_name %></h1>
        <p class="text-sm text-slate-600 mt-1"><%= booking.dateLong %> · <%= booking.startTime %> – <%= booking.endTime %> · <%= booking.durationLabel %></p>
      </div>
      <span class="<%= statusColor %> px-3 py-1 rounded-full text-sm font-medium"><%= booking.status.replace('_',' ') %></span>
    </div>

    <% if (booking.rejection_reason) { %>
      <div class="mt-4 px-4 py-2.5 rounded bg-rose-50 text-rose-800 border border-rose-200 text-sm">
        <strong>Reason for rejection:</strong> <%= booking.rejection_reason %>
      </div>
    <% } %>

    <dl class="mt-6 grid sm:grid-cols-2 gap-4 text-sm">
      <div>
        <dt class="text-xs uppercase text-slate-500">Student</dt>
        <dd class="mt-0.5"><%= student.name %></dd>
        <dd class="text-xs text-slate-500"><%= student.email %></dd>
        <% if (student.phone) { %><dd class="text-xs text-slate-500"><%= student.phone %></dd><% } %>
        <% if (student.department) { %><dd class="text-xs text-slate-500"><%= student.department %></dd><% } %>
      </div>
      <div>
        <dt class="text-xs uppercase text-slate-500">Faculty supervisor</dt>
        <dd class="mt-0.5"><%= supervisor ? supervisor.name : '—' %></dd>
        <% if (supervisor && supervisor.email) { %><dd class="text-xs text-slate-500"><%= supervisor.email %></dd><% } %>
      </div>
      <div>
        <dt class="text-xs uppercase text-slate-500">Purpose / sample</dt>
        <dd class="mt-0.5"><%= booking.purpose || '—' %></dd>
      </div>
      <div>
        <dt class="text-xs uppercase text-slate-500">Sample count</dt>
        <dd class="mt-0.5"><%= booking.sample_count || 1 %></dd>
      </div>
      <% if (booking.technician_notes) { %>
        <div class="sm:col-span-2">
          <dt class="text-xs uppercase text-slate-500">Technician notes</dt>
          <dd class="mt-0.5 text-slate-700"><%= booking.technician_notes %></dd>
        </div>
      <% } %>
    </dl>
  </section>

  <section class="bg-white border rounded-xl p-4">
    <h2 class="text-sm font-semibold text-slate-700 mb-3">Timeline</h2>
    <ol class="space-y-3">
      <% events.forEach(function(e){ %>
        <li class="flex gap-3">
          <div class="mt-1 w-2 h-2 rounded-full
            <%= ['technician_approved','faculty_approved'].includes(e.event_type) ? 'bg-emerald-500' :
                ['technician_rejected','faculty_rejected','cancelled','no_show'].includes(e.event_type) ? 'bg-rose-500' :
                'bg-slate-400' %>"></div>
          <div class="flex-1">
            <div class="text-sm text-slate-900"><%= e.event_type.replace(/_/g,' ') %></div>
            <div class="text-xs text-slate-500">
              <%= e.actor_name || 'system' %><% if (e.actor_role) { %> · <%= e.actor_role %><% } %>
              · <%= e.created_at.replace('T',' ').slice(0,16) %>
            </div>
            <% if (e.detail) { %>
              <div class="text-xs text-slate-700 mt-0.5">"<%= e.detail %>"</div>
            <% } %>
          </div>
        </li>
      <% }) %>
    </ol>

    <% if (user.role !== 'student') { %>
      <div class="mt-4 pt-4 border-t text-xs text-slate-500">
        Student email: <a href="mailto:<%= student.email %>" class="text-brand-600 hover:underline"><%= student.email %></a>
      </div>
    <% } %>
  </section>
</div>
<%- include('../partials/foot') %>
