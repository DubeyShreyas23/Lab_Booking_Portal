<%- include('../partials/head') %>
<div class="max-w-md mx-auto mt-8 bg-white border rounded-xl shadow-sm p-6">
  <h1 class="text-xl font-semibold text-slate-900">Complete your profile</h1>
  <p class="text-sm text-slate-500 mt-1">A few details so we can route your bookings correctly.</p>

  <form method="post" action="/signup" class="mt-5 space-y-3">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="text-sm text-slate-600">Email: <span class="font-medium text-slate-900"><%= user.email %></span></div>
    <label class="block">
      <span class="text-sm text-slate-700">Full name</span>
      <input name="name" type="text" required value="<%= user.name || '' %>" class="mt-1 w-full px-3 py-2 border rounded">
    </label>
    <label class="block">
      <span class="text-sm text-slate-700">Mobile number</span>
      <input name="phone" type="tel" required value="<%= user.phone || '' %>" pattern="[0-9 +\-]{10,15}" placeholder="+91 9XXXXXXXXX"
             class="mt-1 w-full px-3 py-2 border rounded">
    </label>
    <label class="block">
      <span class="text-sm text-slate-700">Department <span class="text-slate-400">(optional)</span></span>
      <input name="department" type="text" value="<%= user.department || '' %>" class="mt-1 w-full px-3 py-2 border rounded" placeholder="e.g. Chemical Engineering">
    </label>
    <button class="w-full bg-brand-500 hover:bg-brand-600 text-white py-2 rounded font-medium">Save and continue</button>
  </form>
</div>
<%- include('../partials/foot') %>
