<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta http-equiv="refresh" content="60">
  <title>Today at BEST Lab · <%= today %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>tailwind.config = { theme: { extend: { colors: { brand: { 500:'#1a56db', 700:'#103a92' } } } } }</script>
</head>
<body class="bg-slate-900 text-slate-100 min-h-screen">
  <header class="px-8 py-4 flex items-center justify-between border-b border-slate-700">
    <div class="flex items-center gap-3">
      <span class="inline-block w-10 h-10 rounded bg-brand-500 grid place-items-center font-bold">BEST</span>
      <div>
        <div class="font-semibold text-lg">BEST Lab</div>
        <div class="text-xs text-slate-400">BITS Pilani Hyderabad Campus · today's bookings</div>
      </div>
    </div>
    <div class="text-right">
      <div class="text-2xl font-mono"><%= now %></div>
      <div class="text-xs text-slate-400"><%= today %></div>
    </div>
  </header>

  <main class="p-6 grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4">
    <% instruments.forEach(function(inst){
         var todays = byInstrument[inst.id] || [];
    %>
      <section class="bg-slate-800 border border-slate-700 rounded-xl p-4">
        <header class="flex items-baseline justify-between border-b border-slate-700 pb-2">
          <div>
            <h2 class="font-semibold text-lg"><%= inst.name %></h2>
            <div class="text-xs text-slate-400"><%= inst.code %><% if (inst.location) { %> · <%= inst.location %><% } %></div>
          </div>
          <div class="text-xs text-slate-400 text-right">
            <%= String(inst.open_hour).padStart(2,'0') %>:00 – <%= String(inst.close_hour).padStart(2,'0') %>:00<br>
            <%= ((inst.experiment_minutes + inst.maintenance_minutes)/60).toFixed(1) %> hr / run
          </div>
        </header>
        <% if (!todays.length) { %>
          <div class="py-6 text-center text-slate-500 text-sm">No bookings today</div>
        <% } else { %>
          <ol class="mt-2 space-y-1.5 text-sm">
            <% todays.forEach(function(b){
                 var sIso = new Date(b.starts_at);
                 var eIso = new Date(b.ends_at);
                 var pad = (n) => String(n).padStart(2,'0');
                 var sLabel = pad(sIso.getHours()) + ':' + pad(sIso.getMinutes());
                 var eLabel = pad(eIso.getHours()) + ':' + pad(eIso.getMinutes());
                 var color = b.status === 'approved' ? 'bg-emerald-700/40 border-emerald-500/40' : 'bg-amber-700/30 border-amber-500/40';
            %>
              <li class="<%= color %> border rounded px-3 py-2 flex items-center gap-3">
                <span class="font-mono text-xs text-slate-300 w-24"><%= sLabel %>–<%= eLabel %></span>
                <span class="flex-1 truncate"><%= b.student_name %></span>
                <span class="text-xs uppercase tracking-wide text-slate-300"><%= b.status.replace('_',' ') %></span>
              </li>
            <% }) %>
          </ol>
        <% } %>
      </section>
    <% }) %>
  </main>

  <footer class="text-center text-xs text-slate-500 py-4">
    Auto-refreshes every 60 s · view in your browser at /kiosk
  </footer>
</body>
</html>
