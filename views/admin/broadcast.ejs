<%- include('../partials/head') %>
<h1 class="text-2xl font-semibold text-slate-900 mb-1">Send announcement</h1>
<p class="text-sm text-slate-500 mb-5">
  Sends one email to every real lab member below (admin accounts are never included).
  Review the recipient list and message before sending — nothing goes out until you click Send.
</p>

<div class="grid lg:grid-cols-[1fr_320px] gap-6">
  <section class="bg-white border rounded-xl p-5">
    <form method="post" action="/admin/broadcast" class="space-y-4 text-sm"
          onsubmit="return confirm('Send this email to all <%= recipients.length %> recipients? This cannot be undone.')">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <label class="block">
        <span class="text-slate-700 font-medium">Subject</span>
        <input name="subject" required value="<%= defaultSubject %>" class="mt-1 w-full px-3 py-2 border rounded">
      </label>

      <label class="block">
        <span class="text-slate-700 font-medium">Message</span>
        <textarea name="body" required rows="24"
                  class="mt-1 w-full px-3 py-2 border rounded font-mono text-xs leading-relaxed"><%= defaultBody %></textarea>
      </label>

      <button class="bg-brand-500 hover:bg-brand-600 text-white px-5 py-2.5 rounded font-medium">
        Send to <%= recipients.length %> recipient<%= recipients.length === 1 ? '' : 's' %>
      </button>
    </form>

    <% if (result) { %>
      <div class="mt-6 border-t pt-4">
        <h2 class="text-sm font-semibold text-slate-700 mb-2">Send results</h2>
        <ul class="text-xs divide-y border rounded-lg overflow-hidden">
          <% result.forEach(function(r){ %>
            <li class="px-3 py-1.5 flex items-center justify-between <%= r.ok ? '' : 'bg-rose-50' %>">
              <span><%= r.name %> &lt;<%= r.email %>&gt;</span>
              <% if (r.ok) { %>
                <span class="text-emerald-700 font-medium">sent</span>
              <% } else { %>
                <span class="text-rose-700 font-medium" title="<%= r.error %>">failed</span>
              <% } %>
            </li>
          <% }) %>
        </ul>
      </div>
    <% } %>
  </section>

  <section class="bg-white border rounded-xl p-4">
    <h2 class="font-semibold text-slate-900 text-sm">Recipients (<%= recipients.length %>)</h2>
    <p class="text-xs text-slate-500 mt-1">Only student / technician / faculty accounts. If someone shouldn't be here, fix their role in <a href="/admin/users" class="text-brand-600 hover:underline">Users</a> first.</p>
    <ul class="mt-3 text-xs divide-y border rounded-lg overflow-hidden max-h-[32rem] overflow-y-auto">
      <% recipients.forEach(function(r){ %>
        <li class="px-3 py-2 flex items-center justify-between">
          <div class="min-w-0">
            <div class="font-medium truncate"><%= r.name %></div>
            <div class="text-slate-500 truncate"><%= r.email %></div>
          </div>
          <span class="text-[10px] uppercase tracking-wide text-slate-400 shrink-0 ml-2"><%= roleLabel(r.role) %></span>
        </li>
      <% }) %>
      <% if (!recipients.length) { %>
        <li class="px-3 py-6 text-center text-slate-500">No recipients found.</li>
      <% } %>
    </ul>
  </section>
</div>
<%- include('../partials/foot') %>
