<%- include('../partials/head') %>
<h1 class="text-2xl font-semibold text-slate-900 mb-1">Equipment Inventory</h1>
<p class="text-sm text-slate-500 mb-4"><%= counts.total %> instruments across the labs.</p>

<div class="grid grid-cols-2 sm:grid-cols-5 gap-3 mb-5">
  <% const cards = [
       ['Total', counts.total, 'text-slate-900'],
       ['Working', counts.working, 'text-emerald-700'],
       ['Repair', counts.repair, 'text-rose-700'],
       ['Booked now', counts.booked, 'text-amber-700'],
       ['Available', counts.available, 'text-sky-700'],
     ]; %>
  <% cards.forEach(function(c){ %>
    <div class="bg-white border rounded-xl p-3">
      <div class="text-xs uppercase tracking-wide text-slate-500"><%= c[0] %></div>
      <div class="text-2xl font-semibold <%= c[2] %>"><%= c[1] %></div>
    </div>
  <% }) %>
</div>

<div class="flex flex-wrap items-center gap-2 mb-3 text-sm">
  <span class="text-slate-500">Lab:</span>
  <a href="/admin/inventory" class="px-2.5 py-1 rounded <%= !labFilter ? 'bg-brand-500 text-white' : 'bg-white border hover:bg-slate-50' %>">All</a>
  <% labs.forEach(function(l){ %>
    <a href="/admin/inventory?lab=<%= encodeURIComponent(l) %>"
       class="px-2.5 py-1 rounded <%= labFilter === l ? 'bg-brand-500 text-white' : 'bg-white border hover:bg-slate-50' %>"><%= l %></a>
  <% }) %>
</div>

<div class="bg-white border rounded-xl overflow-x-auto">
  <table class="w-full text-sm">
    <thead class="bg-slate-50 text-slate-600 text-left text-xs">
      <tr>
        <th class="px-3 py-2">Code</th>
        <th class="px-3 py-2">Instrument</th>
        <th class="px-3 py-2">Lab</th>
        <th class="px-3 py-2">Type</th>
        <th class="px-3 py-2">Booking</th>
        <th class="px-3 py-2">Technician</th>
        <th class="px-3 py-2">Status</th>
      </tr>
    </thead>
    <tbody class="divide-y">
      <% items.forEach(function(i){ %>
        <tr class="<%= i.status === 'repair' ? 'bg-rose-50/40' : '' %>">
          <td class="px-3 py-2 font-mono text-xs"><%= i.code %></td>
          <td class="px-3 py-2">
            <div class="font-medium"><%= i.name %></div>
            <div class="text-xs text-slate-400"><%= i.make_model || '' %><% if (i.parameters) { %> · <%= i.parameters %><% } %></div>
          </td>
          <td class="px-3 py-2 text-xs"><%= i.lab || '—' %></td>
          <td class="px-3 py-2 text-xs">
            <%= i.category || '—' %>
            <div class="text-slate-400"><%= i.booking_mode === 'daily' ? (i.duration_days + ' day' + (i.duration_days>1?'s':'')) : ((i.experiment_minutes/60).toFixed(1) + ' hr') %></div>
          </td>
          <td class="px-3 py-2 text-xs">
            <% if (i.isBooked) { %><span class="text-amber-700 font-medium">In use now</span><% } else { %><span class="text-slate-400">Free</span><% } %>
          </td>
          <td class="px-3 py-2 text-xs">
            <form method="post" action="/admin/inventory/<%= i.id %>/technician" class="inline">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <select name="technician_id" onchange="this.form.submit()"
                class="px-2 py-1 border rounded text-xs <%= i.technician_id ? '' : 'border-amber-300 text-amber-700' %>">
                <option value="">— none —</option>
                <% technicians.forEach(function(t){ %>
                  <option value="<%= t.id %>" <%= i.technician_id==t.id?'selected':'' %>><%= t.name %></option>
                <% }) %>
              </select>
            </form>
          </td>
          <td class="px-3 py-2">
            <form method="post" action="/admin/inventory/<%= i.id %>/status" class="inline">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <select name="status" onchange="this.form.submit()"
                class="px-2 py-1 border rounded text-xs <%= i.status === 'repair' ? 'text-rose-700 border-rose-300' : i.status === 'retired' ? 'text-slate-500' : 'text-emerald-700 border-emerald-300' %>">
                <% ['working','repair','retired'].forEach(function(s){ %>
                  <option value="<%= s %>" <%= (i.status||'working') === s ? 'selected' : '' %>><%= s %></option>
                <% }) %>
              </select>
            </form>
          </td>
        </tr>
      <% }) %>
      <% if (!items.length) { %>
        <tr><td colspan="7" class="px-3 py-8 text-center text-slate-500">No instruments. Run the equipment import.</td></tr>
      <% } %>
    </tbody>
  </table>
</div>
<%- include('../partials/foot') %>
